{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/.opencode",
      "!**/.agents",
      "!**/.claude",
      "!**/.codex",
      "!**/node_modules",
      "!**/dist",
      "!**/my-project",
      "!**/bun.lock",
      "!**/planning docs"
    ]
  }
}
