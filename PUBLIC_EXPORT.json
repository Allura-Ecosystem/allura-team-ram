{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "name": "Team RAM public package source",
  "canonicalRepository": "https://github.com/Allura-Ecosystem/allura-team-ram.git",
  "consumer": "https://github.com/Allura-Ecosystem/allura-plugins.git",
  "categories": {
    "agents": [
      "agents/**",
      ".opencode/agent/**",
      ".claude/agents/**",
      ".claude-plugin/agents/**",
      ".codex/agents/**"
    ],
    "commands": [".opencode/command/**", ".claude/commands/**", ".claude-plugin/commands/**"],
    "skills": [
      ".agents/skills/**",
      ".opencode/skills/**",
      ".claude/skills/**",
      ".claude-plugin/skills/**",
      "bmad-module/skills/**"
    ],
    "config": [
      ".opencode/config/**",
      ".opencode/contracts/**",
      ".opencode/hooks/**",
      ".opencode/routing/**",
      ".opencode/team-ram-presets.jsonc",
      ".claude/rules/**",
      ".claude-plugin/.mcp.json",
      ".claude-plugin/hooks.json",
      ".claude-plugin/marketplace.json",
      ".claude-plugin/plugin.json",
      ".codex-plugin/plugin.json",
      ".mcp.json",
      "hooks/**",
      "team-ram-presets.schema.json",
      "bmad-module/.claude-plugin/**",
      "bmad-module/tools/**"
    ],
    "runtime": [
      "bin/**",
      "src/**",
      "scripts/apply-preset.sh",
      "scripts/lint-agents.sh",
      "tooling/agent-sync/**",
      "migrations/**"
    ],
    "documentation": [
      "README.md",
      "LICENSE",
      "CHANGELOG.md",
      "SOURCE.json",
      "PUBLIC_EXPORT.json",
      "docs/installation.md",
      "docs/configuration.md",
      "docs/ecosystem-relationships.md",
      "docs/agents.md",
      "docs/presets.md",
      "docs/dual-runtime.md",
      "docs/quick-reference.md",
      "docs/TESTING.md",
      ".opencode/SERVICES.md",
      ".claude-plugin/README.md",
      "bmad-module/README.md"
    ],
    "release": ["scripts/export-public.mjs", "scripts/validate-public-export.mjs"]
  },
  "publicRoots": {
    "agents": [
      "agents/",
      ".opencode/agent/",
      ".claude/agents/",
      ".claude-plugin/agents/",
      ".codex/agents/"
    ],
    "commands": [".opencode/command/", ".claude/commands/", ".claude-plugin/commands/"],
    "skills": [
      ".agents/skills/",
      ".opencode/skills/",
      ".claude/skills/",
      ".claude-plugin/skills/",
      "bmad-module/skills/"
    ],
    "config": [
      ".opencode/config/",
      ".opencode/contracts/",
      ".opencode/hooks/",
      ".opencode/routing/",
      ".claude/rules/",
      "hooks/",
      "bmad-module/.claude-plugin/",
      "bmad-module/tools/"
    ]
  },
  "packageFiles": [
    "agents/**",
    ".opencode/agent/**",
    ".claude/agents/**",
    ".claude-plugin/agents/**",
    ".codex/agents/**",
    ".opencode/command/**",
    ".claude/commands/**",
    ".claude-plugin/commands/**",
    ".agents/skills/**",
    ".opencode/skills/**",
    ".claude/skills/**",
    ".claude-plugin/skills/**",
    "bmad-module/skills/**",
    ".opencode/config/**",
    ".opencode/contracts/**",
    ".opencode/hooks/**",
    ".opencode/routing/**",
    ".opencode/team-ram-presets.jsonc",
    ".claude/rules/**",
    ".claude-plugin/.mcp.json",
    ".claude-plugin/hooks.json",
    ".claude-plugin/marketplace.json",
    ".claude-plugin/plugin.json",
    ".codex-plugin/plugin.json",
    ".mcp.json",
    "hooks/**",
    "team-ram-presets.schema.json",
    "bmad-module/.claude-plugin/**",
    "bmad-module/tools/**",
    "bin/**",
    "src/**",
    "scripts/apply-preset.sh",
    "scripts/lint-agents.sh",
    "tooling/agent-sync/**",
    "migrations/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SOURCE.json",
    "PUBLIC_EXPORT.json",
    "docs/installation.md",
    "docs/configuration.md",
    "docs/ecosystem-relationships.md",
    "docs/agents.md",
    "docs/presets.md",
    "docs/dual-runtime.md",
    "docs/quick-reference.md",
    "docs/TESTING.md",
    ".opencode/SERVICES.md",
    ".claude-plugin/README.md",
    "bmad-module/README.md",
    "scripts/export-public.mjs",
    "scripts/validate-public-export.mjs"
  ],
  "excluded": [
    "opencode.json is a repository-local runnable example and may contain host-specific changes",
    "opencode.json.bak* files are local backups",
    "planning and evidence trees are development/history inputs, not package source",
    "tests and CI configuration validate the source but are not runtime package payload"
  ]
}
