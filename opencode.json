{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "bahari": {
      "fallback_model": "openai/gpt-5.6-terra",
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "path": ".opencode/agent/core/bahari.md",
      "permission": {
        "skill": {
          "*": "allow"
        },
        "task": "allow"
      }
    },
    "bellard": {
      "fallback_model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "path": ".opencode/agent/subagents/code/bellard.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "brooks": {
      "fallback_model": "openai/gpt-5.6-terra",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "path": ".opencode/agent/core/brooks.md",
      "permission": {
        "skill": {
          "*": "allow"
        },
        "task": "allow"
      }
    },
    "carmack": {
      "fallback_model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "path": ".opencode/agent/subagents/code/carmack.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "fowler": {
      "fallback_model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "path": ".opencode/agent/subagents/review/fowler.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "hightower": {
      "fallback_model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "path": ".opencode/agent/subagents/infrastructure/hightower.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "jobs": {
      "fallback_model": "openai/gpt-5.6-terra",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "path": ".opencode/agent/core/jobs.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "knuth": {
      "fallback_model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "path": ".opencode/agent/subagents/infrastructure/knuth.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "pike": {
      "fallback_model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "path": ".opencode/agent/subagents/review/pike.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "scout": {
      "fallback_model": "openai/gpt-5.6-terra",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "path": ".opencode/agent/subagents/core/scout.md",
      "permission": {
        "edit": "allow",
        "skill": {
          "*": "allow"
        },
        "task": "allow",
        "write": "allow"
      }
    },
    "woz": {
      "fallback_model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "path": ".opencode/agent/subagents/code/woz.md",
      "permission": {
        "skill": {
          "*": "allow"
        },
        "task": "allow"
      }
    }
  },
  "default_agent": "brooks",
  "instructions": [
    ".opencode/AGENTS.md",
    ".opencode/agent/core/brooks.md",
    ".opencode/agent/core/jobs.md",
    ".opencode/AGENTS.md"
  ],
  "mcp": {
    "allura-brain": {
      "enabled": true,
      "timeout": 60000,
      "type": "remote",
      "url": "http://localhost:5888/mcp"
    },
    "mcp-docker": {
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run"
      ],
      "enabled": true,
      "timeout": 60000,
      "type": "local"
    },
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "type": "local"
    }
  },
  "model": "openai/gpt-5.6-terra",
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "external_directory": "allow",
    "glob": "allow",
    "grep": "allow",
    "question": "deny",
    "read": "allow",
    "skill": {
      "*": "allow",
      "agent-bahari": "allow",
      "allura-memory-skill": "allow",
      "mcp-docker": "allow",
      "team-ram-cowork": "allow"
    },
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "write": "allow"
  },
  "plugin": [
    "@razroo/opencode-model-fallback",
    "opencode-scheduler"
  ],
  "provider": {
    "ollama": {
      "models": {
        "nomic-embed-text:latest": {
          "name": "nomic-embed-text:latest"
        },
        "qwen3-embedding:8b": {
          "name": "qwen3-embedding:8b"
        },
        "qwen3:0.6b": {
          "name": "qwen3:0.6b"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "chunkTimeout": 60000,
        "timeout": 600000
      }
    },
    "openai": {
      "whitelist": [
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-5.6-luna"
      ]
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "small_model": "openai/gpt-5.6-luna"
}