{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "bahari": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "primary",
      "model": "ollama/nemotron-3-super:cloud",
      "path": ".opencode/agent/core/bahari.md",
      "permission": {
        "skill": {
          "*": "allow"
        },
        "task": "allow"
      }
    },
    "bellard": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/kimi-k2.7-code:cloud",
      "path": ".opencode/agent/subagents/code/bellard.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "brooks": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "primary",
      "model": "ollama/glm-5.2.2:cloud",
      "path": ".opencode/agent/core/brooks.md",
      "permission": {
        "skill": {
          "*": "allow"
        },
        "task": "allow"
      }
    },
    "carmack": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/kimi-k2.7-code:cloud",
      "path": ".opencode/agent/subagents/code/carmack.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "fowler": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/kimi-k2.7-code:cloud",
      "path": ".opencode/agent/subagents/review/fowler.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "hightower": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/kimi-k2.7-code:cloud",
      "path": ".opencode/agent/subagents/infrastructure/hightower.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "jobs": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "primary",
      "model": "ollama/glm-5.2.2:cloud",
      "path": ".opencode/agent/core/jobs.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "knuth": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/kimi-k2.7-code:cloud",
      "path": ".opencode/agent/subagents/infrastructure/knuth.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "pike": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/kimi-k2.7-code:cloud",
      "path": ".opencode/agent/subagents/review/pike.md",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "scout": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/nemotron-3-super:cloud",
      "path": ".opencode/agent/subagents/core/scout.md",
      "permission": {
        "edit": "allow",
        "skill": {
          "*": "allow"
        },
        "task": "allow",
        "write": "allow"
      }
    },
    "woz": {
      "fallback_model": "ollama/glm-5.1:cloud",
      "mode": "subagent",
      "model": "ollama/kimi-k2.7-code:cloud",
      "path": ".opencode/agent/subagents/code/woz.md",
      "permission": {
        "skill": {
          "*": "allow"
        },
        "task": "allow"
      }
    }
  },
  "default_agent": "brooks",
  "instructions": [
    ".opencode/AGENTS.md",
    ".opencode/agent/core/brooks.md",
    ".opencode/agent/core/jobs.md",
    ".opencode/AGENTS.md"
  ],
  "mcp": {
    "allura-brain": {
      "enabled": true,
      "timeout": 60000,
      "type": "remote",
      "url": "http://localhost:5888/mcp"
    },
    "mcp-docker": {
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run"
      ],
      "enabled": true,
      "timeout": 60000,
      "type": "local"
    },
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "type": "local"
    }
  },
  "model": "ollama/glm-5.2.1:cloud",
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "external_directory": "allow",
    "glob": "allow",
    "grep": "allow",
    "question": "deny",
    "read": "allow",
    "skill": {
      "*": "allow",
      "agent-bahari": "allow",
      "allura-memory-skill": "allow",
      "mcp-docker": "allow",
      "team-ram-cowork": "allow"
    },
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "write": "allow"
  },
  "plugin": [
    "@razroo/opencode-model-fallback",
    "opencode-scheduler"
  ],
  "provider": {
