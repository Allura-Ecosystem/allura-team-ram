{
  "runtimes": ["codex", "opencode", "claude"],
  "formats": {
    "codex": ".codex/agents/<name>.toml",
    "opencode": ".opencode/agent/core/<name>.md",
    "claude": ".claude/agents/<name>.md"
  },
  "tiers": {
    "ultrabrain": {
      "codex": "inherit",
      "opencode": null,
      "claude": "inherit"
    },
    "standard": {
      "codex": "inherit",
      "opencode": null,
      "claude": "inherit"
    },
    "cheap": {
      "codex": "inherit",
      "opencode": null,
      "claude": "inherit"
    }
  },
  "agents": {
    "brooks": {
      "tier": "ultrabrain",
      "role": "Chief Architect / orchestrator"
    },
    "jobs": {
      "tier": "ultrabrain",
      "role": "Intent Gate / scope owner"
    },
    "woz": {
      "tier": "standard",
      "role": "Primary Builder"
    },
    "scout": {
      "tier": "cheap",
      "role": "Recon / discovery"
    },
    "pike": {
      "tier": "standard",
      "role": "Interface & simplicity gate"
    },
    "bellard": {
      "tier": "standard",
      "role": "Performance & diagnostics"
    },
    "fowler": {
      "tier": "standard",
      "role": "Maintainability gate / refactor"
    },
    "carmack": {
      "tier": "standard",
      "role": "Performance & optimization"
    },
    "hightower": {
      "tier": "standard",
      "role": "DevOps / infrastructure"
    },
    "knuth": {
      "tier": "standard",
      "role": "Data architect / schema"
    },
    "bahari": {
      "tier": "cheap",
      "role": "Allura Memory Curator"
    },
    "reality-checker-tram": {
      "tier": "cheap",
      "role": "Tier-2 Harness Auditor"
    }
  },
  "$comment": "Model authority. Agent bodies are canonical under .opencode/agent/core. Generated Claude, Codex and plugin adapters share those bodies. null OpenCode model means omit to inherit; Claude uses inherit; Codex keeps the configured session model. Capability tiers express responsibility, not fixed model IDs.",
  "directApi": {
    "modelEnvironment": "TEAM_RAM_ANTHROPIC_MODEL",
    "requires": "Concrete supported Anthropic model ID; no CLI aliases",
    "capabilities": "text generation only; no workspace tools"
  }
}
