  "homepage": "https://github.com/Allura-Ecosystem/allura-team-ram#readme",
  "bugs": {
    "url": "https://github.com/Allura-Ecosystem/allura-team-ram/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "service": "bun src/http-server.ts",
    "service:start": "bash scripts/start-service.sh",
    "test": "bun test",
    "test:integration": "bun run test-integration.ts",
    "test:http": "bun test ./test-http-service.ts",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check . --write",
    "format": "bunx @biomejs/biome format . --write",
    "typecheck": "bunx tsc --noEmit",
    "validate:export": "node scripts/validate-public-export.mjs",
    "validate:packed": "node scripts/validate-packed-plugin.mjs",
    "validate:tarball": "node scripts/validate-tarball.mjs",
    "export:public": "node scripts/export-public.mjs",
    "prompt:baseline": "bun tooling/prompt-evals/prompt-eval.ts .",
    "prompt:eval": "bun test tooling/prompt-evals/prompt-eval.test.ts",
    "sync:codex-skills": "node scripts/sync-codex-skills.mjs",
    "check:codex-skills": "node scripts/sync-codex-skills.mjs --check",
    "team-ram:doctor": "node scripts/team-ram-doctor.mjs"
  },
  "dependencies": {
    "@ruvector/sona": "^0.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
