{
  "name": "@allura/team-ram-harness",
  "version": "0.4.0",
  "description": "Team RAM OpenCode Harness — surgical-team multi-agent orchestration: 10 specialists, deterministic tier routing over Ollama Cloud, governed memory, HITL governance, SONA learning.",
  "author": "Team RAM Contributors",
  "license": "MIT",
  "type": "module",
  "main": "src/http-server.ts",
  "exports": {
    ".": "./src/http-server.ts",
    "./executor": "./src/agent-executor.ts",
    "./curator": "./src/curator.ts",
    "./coherence": "./src/coherence-monitor.ts",
    "./sona": "./src/sona-trajectory.ts",
    "./lifecycle": "./src/agent-lifecycle.ts"
  },
  "bin": {
    "team-ram": "./bin/team-ram.mjs"
  },
  "files": [
    "bin/",
    "src/",
    ".opencode/agent/",
    ".opencode/command/",
    ".opencode/skills/",
    ".opencode/routing/",
    ".opencode/hooks/",
    ".opencode/contracts/",
    ".opencode/config/",
    ".claude/agents/",
    ".claude/commands/",
    ".claude/skills/",
    ".claude/rules/",
    ".codex/agents/",
    "tooling/agent-sync/",
    "scripts/",
    "migrations/",
    "install.sh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "opencode",
    "harness",
    "team-ram",
    "ai-agents",
    "multi-agent",
    "orchestration",
    "ollama",
    "sona",
    "self-evolving"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Allura-Ecosystem/allura-team-ram.git"
  },
  "homepage": "https://github.com/Allura-Ecosystem/allura-team-ram#readme",
  "bugs": {
    "url": "https://github.com/Allura-Ecosystem/allura-team-ram/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "service": "bun src/http-server.ts",
    "service:start": "bash scripts/start-service.sh",
    "test": "bun test",
    "test:integration": "bun run test-integration.ts",
    "test:http": "bun test ./test-http-service.ts",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check . --write",
    "format": "bunx @biomejs/biome format . --write",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@ruvector/sona": "^0.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
