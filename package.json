{
  "name": "@allura/team-ram-harness",
  "version": "0.6.3",
  "description": "Standalone governed multi-agent software-delivery harness with context-first routing, specialist lanes, review gates, and evidence-backed completion.",
  "author": "Team RAM Contributors",
  "license": "MIT",
  "type": "module",
  "main": "src/http-server.ts",
  "exports": {
    ".": "./src/http-server.ts",
    "./executor": "./src/agent-executor.ts",
    "./curator": "./src/curator.ts",
    "./coherence": "./src/coherence-monitor.ts",
    "./sona": "./src/sona-trajectory.ts",
    "./lifecycle": "./src/agent-lifecycle.ts",
    "./context": "./src/context-packet.ts",
    "./tool-loading": "./src/tool-loading.ts"
  },
  "bin": {
    "team-ram": "./bin/team-ram.mjs"
  },
