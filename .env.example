# Optional Allura Memory / Allura Brain integration
# Copy to .env and provide values through your secret manager.

# Governed remote MCP endpoint. Do not point agents at a database directly.
ALLURA_MCP_URL=https://your-allura-host.example/mcp
ALLURA_MCP_TOKEN=

# Tenant isolation
DEFAULT_GROUP_ID=allura-system

# Harness HTTP service
HARNESS_PORT=7654
HARNESS_API_KEY=
